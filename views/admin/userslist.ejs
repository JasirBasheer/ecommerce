<script>
  async function handleUnblock(userId){
    const result = await Swal.fire({
      title: 'Are you sure?',
      text: "You are about to unblock this user. They will be able to access the platform again.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#28a745',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, unblock user!',
      cancelButtonText: 'Cancel'
    });

    if (result.isConfirmed) {
      const button = event.target;
      const originalText = button.innerHTML;
      
      try {
        button.classList.add('loading');
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        button.disabled = true;

        const response = await fetch('/admin/unblockuser',{
          method:"POST",
          headers:{
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ userId })
        });

        const data = await response.json();
        
        if (response.ok && data.success) {
          updateUserStatus(userId, false);
          showNotification(data.message || 'User unblocked successfully', 'success');
        } else {
          showNotification(data.message || 'Failed to unblock user', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showNotification('An error occurred', 'error');
      } finally {
        button.classList.remove('loading');
        button.innerHTML = originalText;
        button.disabled = false;
      }
    }
  }

  async function handleblock(userId){
    const result = await Swal.fire({
      title: 'Are you sure?',
      text: "You are about to block this user. They will not be able to access the platform.",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, block user!',
      cancelButtonText: 'Cancel'
    });

    if (result.isConfirmed) {
      const button = event.target;
      const originalText = button.innerHTML;
      
      try {
        button.classList.add('loading');
        button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
        button.disabled = true;

        const response = await fetch('/admin/blockuser',{
          method:"POST",
          headers:{
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ userId })
        });

        const data = await response.json();
        
        if (response.ok && data.success) {
          updateUserStatus(userId, true);
          showNotification(data.message || 'User blocked successfully', 'success');
        } else {
          showNotification(data.message || 'Failed to block user', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showNotification('An error occurred', 'error');
      } finally {
        button.classList.remove('loading');
        button.innerHTML = originalText;
        button.disabled = false;
      }
    }
  }

  function updateUserStatus(userId, isBlocked) {
    const userRow = document.querySelector(`tr[data-user-id="${userId}"]`);
    if (!userRow) return;

    const statusCell = userRow.querySelector('.user-status');
    if (statusCell) {
      statusCell.innerHTML = isBlocked 
        ? '<span class="badge bg-danger">Blocked</span>' 
        : '<span class="badge bg-success">Active</span>';
    }
    
    const actionCell = userRow.querySelector('.action-buttons');
    if (actionCell) {
      if (isBlocked) {
        actionCell.innerHTML = `
          <button type="button" class="btn btn-success btn-sm me-2" onclick="handleUnblock('${userId}')">
            <i class="fas fa-unlock"></i> Unblock
          </button>
          <button type="button" class="btn btn-secondary btn-sm" style="display: none;">
            <i class="fas fa-lock"></i> Block
          </button>
        `;
      } else {
        actionCell.innerHTML = `
          <button type="button" class="btn btn-secondary btn-sm me-2" style="display: none;">
            <i class="fas fa-unlock"></i> Unblock
          </button>
          <button type="button" class="btn btn-danger btn-sm" onclick="handleblock('${userId}')">
            <i class="fas fa-lock"></i> Block
          </button>
        `;
      }
    }
  }

  function showNotification(message, type) {
    const Toast = Swal.mixin({
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true,
      didOpen: (toast) => {
        toast.addEventListener('mouseenter', Swal.stopTimer)
        toast.addEventListener('mouseleave', Swal.resumeTimer)
      }
    })

    //  if (type === 'success') {
    //    Toast.fire({
    //      icon: 'success',
    //      title: message,
    //      background: '#d4edda',
    //      color: '#155724',
    //      iconColor: '#28a745'
    //    })
    //  } else {
    //    Toast.fire({
    //      icon: 'error',
    //      title: message,
    //      background: '#f8d7da',
    //      color: '#721c24',
    //      iconColor: '#dc3545'
    //    })
    //  }
   }

   let searchTimeout;
   let currentPage = <%= currentPage || 1 %>;
   let currentSearch = '<%= search || "" %>';
   let currentLimit = <%= limit || 1 %>;

   document.addEventListener('DOMContentLoaded', function() {
     const searchInput = document.getElementById('userSearchInput');
     if (searchInput && currentSearch) {
       searchInput.value = currentSearch;
     }
   });

    async function performSearch(searchTerm) {
      try {
        const tbody = document.querySelector('tbody');
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; padding: 2rem;">
              <i class="fas fa-spinner fa-spin"></i> Searching...
            </td>
          </tr>
        `;

        const response = await fetch(`/admin/searchusers?search=${encodeURIComponent(searchTerm)}&page=${currentPage}&limit=${currentLimit}`);
        const data = await response.json();

        if (data.success) {
          updateTableWithResults(data.users, data.pagination, searchTerm);
          updatePaginationInfo(data.pagination, searchTerm);
          updatePaginationControls(data.pagination);
        } else {
          showErrorMessage('Search failed. Please try again.');
        }
      } catch (error) {
        console.error('Search error:', error);
        showErrorMessage('Error occurred while searching');
      }
    }

    function updateTableWithResults(users, pagination, searchTerm) {
      const tbody = document.querySelector('tbody');
      
      if (users.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; padding: 2rem; color: #6c757d;">
              <i class="fas fa-search"></i><br>
              No users found matching "${searchTerm}"
            </td>
          </tr>
        `;
      } else {
        let tableHTML = '';
        users.forEach(user => {
          const statusBadge = user.is_blocked ? 
            '<span class="badge bg-danger">Blocked</span>' : 
            '<span class="badge bg-success">Active</span>';
          
          const actionButtons = user.is_blocked ? 
            `<button type="button" class="btn btn-success btn-sm me-2" onclick="handleUnblock('${user._id}')">
               <i class="fas fa-unlock"></i> Unblock
             </button>
             <button type="button" class="btn btn-secondary btn-sm" style="display: none;">
               <i class="fas fa-lock"></i> Block
             </button>` :
            `<button type="button" class="btn btn-secondary btn-sm me-2" style="display: none;">
               <i class="fas fa-unlock"></i> Unblock
             </button>
             <button type="button" class="btn btn-danger btn-sm" onclick="handleblock('${user._id}')">
               <i class="fas fa-lock"></i> Block
             </button>`;

          tableHTML += `
            <tr style="font-size: medium;" data-user-id="${user._id}">
              <td data-title="Name">${user.name}</td>
              <td data-title="Email">${user.email}</td>
              <td data-title="Mobile">${user.phone || 'N/A'}</td>
              <td data-title="Status" class="user-status">${statusBadge}</td>
              <td data-title="Actions" class="action-buttons">${actionButtons}</td>
            </tr>
          `;
        });
        tbody.innerHTML = tableHTML;
      }
    }

    function updatePaginationInfo(pagination, searchTerm) {
      const paginationInfo = document.querySelector('.pagination-info');
      if (paginationInfo) {
        paginationInfo.innerHTML = `
          <span class="text-muted">
            Showing ${pagination.totalUsers} users
            ${searchTerm ? `for "${searchTerm}"` : ''}
          </span>
          <span class="ms-3">Page ${pagination.currentPage} of ${pagination.totalPages}</span>
        `;
      }
    }

    function showErrorMessage(message) {
      const tbody = document.querySelector('tbody');
      tbody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align: center; padding: 2rem; color: #dc3545;">
            <i class="fas fa-exclamation-triangle"></i><br>
            ${message}
          </td>
        </tr>
      `;
    }

    async function goToPage(page) {
      currentPage = page;
      await performSearch(currentSearch);
    }

    function updatePaginationControls(pagination) {
      const paginationContainer = document.querySelector('.pagination-controls');
      if (paginationContainer) {
        let paginationHTML = `
          <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
        `;
        
        if (pagination.hasPrevPage) {
          paginationHTML += `
            <li class="page-item">
              <a class="page-link" href="#" onclick="goToPage(${pagination.prevPage}); return false;">
                <i class="fas fa-chevron-left"></i> Previous
              </a>
            </li>
          `;
        } else {
          paginationHTML += `
            <li class="page-item disabled">
              <span class="page-link disabled">
                <i class="fas fa-chevron-left"></i> Previous
              </span>
            </li>
          `;
        }
        
        for (let i = 1; i <= pagination.totalPages; i++) {
          const activeClass = i === pagination.currentPage ? 'active' : '';
          paginationHTML += `
            <li class="page-item ${activeClass}">
              <a class="page-link" href="#" onclick="goToPage(${i}); return false;">
                ${i}
              </a>
            </li>
          `;
        }
        
        if (pagination.hasNextPage) {
          paginationHTML += `
            <li class="page-item">
              <a class="page-link" href="#" onclick="goToPage(${pagination.nextPage}); return false;">
                Next <i class="fas fa-chevron-right"></i>
              </a>
            </li>
          `;
        } else {
          paginationHTML += `
            <li class="page-item disabled">
              <span class="page-link disabled">
                Next <i class="fas fa-chevron-right"></i>
              </span>
            </li>
          `;
        }
        
        paginationHTML += `
            </ul>
          </nav>
        `;
        
        paginationContainer.innerHTML = paginationHTML;
      }
    }


   document.getElementById('userSearchInput').addEventListener('input', function(e) {
     const searchTerm = e.target.value.trim();
     
     if (searchTimeout) {
       clearTimeout(searchTimeout);
     }
     currentPage = 1;
     searchTimeout = setTimeout(() => {
       performSearch(searchTerm);
     }, 1000);
   });

   document.getElementById('userSearchInput').addEventListener('keydown', function(e) {
     if (e.key === 'Escape') {
       e.target.value = '';
       performSearch(''); 
     }
   });
</script>



