</script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.0.16/dist/sweetalert2.all.min.js"></script>

    <script src="https://cdn.datatables.net/v/bs5/jq-3.6.0/dt-1.13.4/sp-2.1.2/datatables.min.js"></script>
   
    <script>
     let searchTimeout;
    let currentPage = <%= currentPage || 1 %>;
    let currentSearch = '<%= search || "" %>';
    let currentLimit = <%= limit || 8 %>;

    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('q');
      if (searchInput && currentSearch) {
        searchInput.value = currentSearch;
      }
      initializePagination();
    });

    function initializePagination() {
      const pagination = {
        currentPage: <%= currentPage || 1 %>,
        totalPages: <%= totalPages || 1 %>,
        totalProducts: <%= totalProducts || 0 %>,
        limit: <%= limit || 8 %>,
        hasNextPage: <%= hasNextPage || false %>,
        hasPrevPage: <%= hasPrevPage || false %>,
        nextPage: <%= nextPage || 1 %>,
        prevPage: <%= prevPage || 1 %>
      };
      updatePaginationControls(pagination);
    }

    async function performSearch(searchTerm) {
      try {
        const tbody = document.querySelector('tbody');
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align: center; padding: 2rem;">
              <i class="fas fa-spinner fa-spin"></i> Searching...
            </td>
          </tr>
        `;

        const response = await fetch(`/admin/searchproducts?search=${encodeURIComponent(searchTerm)}&page=${currentPage}&limit=${currentLimit}`);
        const data = await response.json();

        if (data.success) {
          updateTableWithResults(data.products, data.pagination, searchTerm);
          updatePaginationControls(data.pagination);
        } else {
          showErrorMessage('Search failed. Please try again.');
        }
      } catch (error) {
        console.error('Search error:', error);
        showErrorMessage('Error occurred while searching');
      }
    }

    function updateTableWithResults(products, pagination, searchTerm) {
      const tbody = document.querySelector('tbody');
      tbody.innerHTML = '';

      if (products.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" style="text-align: center; padding: 2rem;">
              No products found
            </td>
          </tr>
        `;
        return;
      }

      products.forEach(product => {
        const imagesHTML = product.images.map((image, j) => `
          <div id="imageContainer${product._id}${j}" style="display: flex; align-items: center;">
            <img id="productImage${product._id}-${j}"
                src="${image}" 
                alt="${image}"
                width="40px" height="40px" style="margin-bottom: 10px;">
            <form onsubmit="return handleDeleteImg(event, '${product._id}', '${image}', '${j}')">
                <input type="hidden" name="productId" value="${product._id}" />
                <input type="hidden" name="image" value="${image}" />
                <button type="submit" id="productImageDeleteBtn${product._id}-${j}"  class="btn-danger ps-2 mx-md-5" >
                    <i class="fa-sharp fa-solid fa-trash"></i>
                </button>
            </form>
          </div>
        `).join('');

        const toggleButton = product.is_blocked ? `
          <button type="button" class="btn btn-success" onclick="toggleProductStatus('${product._id}', false)">
            <i class="fas fa-unlock"></i> Unblock
          </button>
        ` : `
          <button type="button" class="btn btn-danger" onclick="toggleProductStatus('${product._id}', true)">
            <i class="fas fa-lock"></i> Block
          </button>
        `;

        const row = document.createElement('tr');
        row.style.fontSize = 'medium';
        row.style.textAlign = 'center';
        row.innerHTML = `
          <td data-title="Name">${product.productName}</td>
          <td data-title="Category">${product.productCategory}</td>
          <td data-title="Description">${product.productDescription}</td>
          <td data-title="Price">${product.productPrice}</td>
          <td data-title="No Of Stocks">${product.num_of_stocks}</td>
          <td data-title="Image">${imagesHTML}</td>
          <td data-title="Actions">
            <div style="display: flex; align-items: center;">
              <a href="/admin/editproduct?id=${product._id}" style="margin-right: 15px; margin-left: 15px; text-decoration: none;">
                <span><i class="fa-sharp fa-solid fa-file-pen"></i></span>
              </a>
              ${toggleButton}
            </div>
          </td>
        `;
        tbody.appendChild(row);
      });
    }

    function showErrorMessage(message) {
      const tbody = document.querySelector('tbody');
      tbody.innerHTML = `
        <tr>
          <td colspan="7" style="text-align: center; padding: 2rem; color: red;">
            ${message}
          </td>
        </tr>
      `;
    }

    async function goToPage(page) {
      currentPage = page;
      await performSearch(currentSearch);
    }

    function updatePaginationControls(pagination) {
      const paginationContainer = document.querySelector('.pagination-controls');
      if (paginationContainer) {
        let paginationHTML = `
          <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0" style="text-align: center;">
        `;
        
         if (pagination.hasPrevPage) {
          paginationHTML += `
            <li class="page-item">
              <a class="page-link" href="#" onclick="goToPage(${pagination.prevPage}); return false;">
                <i class="fas fa-chevron-left"></i> Previous
              </a>
            </li>
          `;
        } else {
          paginationHTML += `
            <li class="page-item disabled">
              <span class="page-link disabled">
                <i class="fas fa-chevron-left"></i> Previous
              </span>
            </li>
          `;
        }
        
         for (let i = 1; i <= pagination.totalPages; i++) {
          const activeClass = i === pagination.currentPage ? 'active' : '';
          paginationHTML += `
            <li class="page-item ${activeClass}">
              <a class="page-link" href="#" onclick="goToPage(${i}); return false;">
                ${i}
              </a>
            </li>
          `;
        }
        
         if (pagination.hasNextPage) {
          paginationHTML += `
            <li class="page-item">
              <a class="page-link" href="#" onclick="goToPage(${pagination.nextPage}); return false;">
                Next <i class="fas fa-chevron-right"></i>
              </a>
            </li>
          `;
        } else {
          paginationHTML += `
            <li class="page-item disabled">
              <span class="page-link disabled">
                Next <i class="fas fa-chevron-right"></i>
              </span>
            </li>
          `;
        }
        
        paginationHTML += `
            </ul>
          </nav>
        `;
        
        paginationContainer.innerHTML = paginationHTML;
      }
    }

      document.getElementById('q').addEventListener('input', function(e) {
        const searchTerm = e.target.value.trim();
        
        if (searchTimeout) {
          clearTimeout(searchTimeout);
        }
        currentPage = 1;
        searchTimeout = setTimeout(() => {
          performSearch(searchTerm);
        }, 1000);
      });

      document.getElementById('q').addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          e.target.value = '';
          performSearch('');
        }
      });

