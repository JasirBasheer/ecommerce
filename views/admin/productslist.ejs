      async function toggleProductStatus(productId, shouldBlock) {
        const action = shouldBlock ? 'block' : 'unblock';
        const actionText = shouldBlock ? 'block' : 'unblock';
        const confirmText = shouldBlock ? 'block this product' : 'unblock this product';
        
        try {
          const result = await Swal.fire({
            title: `Are you sure?`,
            text: `You want to ${confirmText}`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: shouldBlock ? '#d33' : '#28a745',
            cancelButtonColor: '#6c757d',
            confirmButtonText: `Yes, ${actionText} it!`,
            cancelButtonText: 'Cancel'
          });

          if (result.isConfirmed) {
            const endpoint = shouldBlock ? '/admin/blockproduct' : '/admin/unblockproduct';
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: {
                'Content-type': 'application/json'
              },
              body: JSON.stringify({ productId })
            });
            
            const data = await response.json();
            
            if (data.success) {
              await Swal.fire({
                title: 'Success!',
                text: `Product ${actionText}ed successfully`,
                icon: 'success',
                timer: 2000,
                timerProgressBar: true
              });
              
              await performSearch(currentSearch);
            } else {
              await Swal.fire({
                title: 'Error!',
                text: data.error || `Failed to ${actionText} product`,
                icon: 'error'
              });
            }
          }
        } catch (error) {
          console.error(`Error ${action}ing product:`, error);
          await Swal.fire({
            title: 'Error!',
            text: `An error occurred while ${action}ing the product`,
            icon: 'error'
          });
        }
      }

      

      document.addEventListener("DOMContentLoaded", function() {
            var alertElement = document.getElementById("success-alert");
            if (alertElement) {
                setTimeout(function() {
                    alertElement.remove();
                }, 3000);
            }
        });

      
        function handleNext(currentPage){
      const page = parseInt(currentPage)+1;
      window.location.href = `/admin/productslist?page=${page}`


    }
    
    function handleprevious(currentPage){
      const page = parseInt(currentPage)-1;
      window.location.href = `/admin/productslist?page=${page}`


    }
    </script>


    
